# ============================================================
# Tech Trends Audio Digest - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env real (já está no .gitignore).
# ============================================================

# Chave da API do Groq (gratuita em: https://console.groq.com/keys)
GROQ_API_KEY=gsk_sua_chave_groq_aqui

# Modelo padrão do Groq (Ex: llama-3.3-70b-versatile ou deepseek-r1-distill-llama-70b)
GROQ_MODEL=llama-3.3-70b-versatile

# Vozes recomendadas para Podcast:
# - francisca (pt-BR-FranciscaNeural - Voz feminina estilo podcast conversacional ultra-natural)
# - thalita   (pt-BR-ThalitaMultilingualNeural - Voz multilingue expressiva)
# - antonio   (pt-BR-AntonioNeural - Voz masculina jornalistica)
TTS_VOICE=francisca

# Cadência de fala (-3% para ritmo cadenciado e solto de podcast)
TTS_RATE=-3%

# OPÇÃO 1: Envio para Discord via Webhook
# Crie um webhook em um canal do Discord:
#   Ajustes do Canal -> Integrações -> Webhooks -> Novo Webhook -> Copiar URL
# Se vazio, o envio é desabilitado (exceto quando --send-discord é usado com --discord-webhook).
DISCORD_WEBHOOK_URL=

# OPÇÃO 2 (opcional): ElevenLabs para vozes de estúdio hyper-realistas
# Gratuito até 10.000 caracteres/mês em https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM